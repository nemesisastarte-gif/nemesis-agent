+	contextLimit, _ := strconv.ParseInt(os.Getenv("NEMESIS_CONTEXT_LIMIT"), 10, 64)
+	if contextLimit <= 0 {
+		contextLimit = 128000
+	}
+	outputLimit, _ := strconv.ParseInt(os.Getenv("NEMESIS_OUTPUT_LIMIT"), 10, 64)
+	if outputLimit <= 0 {
+		outputLimit = 8192
+	}
+	interfaceType := os.Getenv("NEMESIS_INTERFACE_TYPE")
+	provider := ProviderOpenAI
+	if interfaceType == "anthropic" {
+		provider = ProviderAnthropic
+	}
+	thinkingEnabled, _ := strconv.ParseBool(os.Getenv("NEMESIS_THINKING_ENABLED"))
+	canReason := thinkingEnabled && interfaceType != "openai_chat"
+	SupportedModels[NemesisModelID] = Model{
+		ID: NemesisModelID,
+		Name: apiModel,
+		Provider: provider,
+		APIModel: apiModel,
+		ContextWindow: contextLimit,
+		DefaultMaxTokens: outputLimit,
+		CanReason: canReason,
+	}
 }
