diff --git a/internal/nemesis/protocol.go b/internal/nemesis/protocol.go
new file mode 100644
index 0000000..b408caa
--- /dev/null
+++ b/internal/nemesis/protocol.go
@@ -0,0 +1,98 @@
+package nemesis
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+	"strings"
+	"sync"
+	"sync/atomic"
+)
+
+var outputMu sync.Mutex
+var textEmitted atomic.Bool
+
+func Enabled() bool {
+	return os.Getenv("NEMESIS_PROTOCOL") == "1"
+}
+
+func emit(value any) {
+	if !Enabled() {
+		return
+	}
+	payload, err := json.Marshal(value)
+	if err != nil {
+		return
+	}
+	outputMu.Lock()
+	fmt.Fprintln(os.Stdout, string(payload))
+	outputMu.Unlock()
+}
+
+func Text(delta string) {
+	if delta == "" {
+		return
+	}
+	textEmitted.Store(true)
+	emit(map[string]any{
+		"type": "text",
+		"part": map[string]any{"type": "text", "text": delta},
+	})
+}
+
+func Thought(delta string) {
+	if delta == "" {
+		return
+	}
+	emit(map[string]any{
+		"type": "reasoning",
+		"part": map[string]any{"type": "reasoning", "text": delta},
+	})
+}
+
+func HasText() bool {
+	return textEmitted.Load()
+}
+
+func ToolStart(id, name, input string) {
+	emitTool("tool_use_start", id, name, "in_progress", input, nil)
+}
+
+func ToolStop(id, name, input, output string, failed bool) {
+	status := "completed"
+	if failed {
+		status = "failed"
+	}
+	emitTool("tool_use_stop", id, name, status, input, output)
+}
+
+func emitTool(eventType, id, name, status, input string, output any) {
+	state := map[string]any{
+		"status": status,
+		"input":  jsonValue(input),
+		"title":  name,
+	}
+	if output != nil {
+		state["output"] = output
+	}
+	emit(map[string]any{
+		"type": eventType,
+		"part": map[string]any{
+			"type":   "tool",
+			"tool":   name,
+			"callID": id,
+			"state":  state,
+		},
+	})
+}
+
+func jsonValue(raw string) any {
+	if strings.TrimSpace(raw) == "" {
+		return map[string]any{}
+	}
+	var value any
+	if json.Unmarshal([]byte(raw), &value) == nil {
+		return value
+	}
+	return raw
+}
