#!/bin/sh
set -eu

ENGINE="/usr/share/nemesiscode/opencode-portable"

if [ ! -x "$ENGINE" ]; then
  echo "moteur portable introuvable: $ENGINE" >&2
  exit 127
fi

case "${1:-}" in
  --version|-v|version)
    exec "$ENGINE" --version
    ;;
  run)
    shift
    prompt=""
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --continue)
          export NEMESIS_CONTINUE=1
          shift
          ;;
        --model|--format|--log-level)
          [ "$#" -ge 2 ] || { echo "argument manquant pour $1" >&2; exit 2; }
          shift 2
          ;;
        --auto|--print-logs)
          shift
          ;;
        --)
          shift
          prompt="$*"
          break
          ;;
        --*)
          echo "option opencode non prise en charge: $1" >&2
          exit 2
          ;;
        *)
          prompt="$1"
          shift
          if [ "$#" -gt 0 ]; then
            prompt="$prompt $*"
          fi
          break
          ;;
      esac
    done
    exec "$ENGINE" --prompt "$prompt" --output-format json --quiet --cwd "${NEMESIS_WORKSPACE:-$PWD}"
    ;;
  *)
    exec "$ENGINE" "$@"
    ;;
esac
